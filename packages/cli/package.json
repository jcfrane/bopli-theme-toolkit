{
    "name": "@bopli/theme-cli",
    "version": "0.7.0",
    "description": "Create, validate, type, build, package, and locally preview independently deployed Bopli themes.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jcfrane/bopli-theme-toolkit.git",
        "directory": "packages/cli"
    },
    "homepage": "https://github.com/jcfrane/bopli-theme-toolkit#readme",
    "bugs": {
        "url": "https://github.com/jcfrane/bopli-theme-toolkit/issues"
    },
    "keywords": [
        "bopli",
        "theme",
        "vite",
        "vue"
    ],
    "bin": {
        "bopli-theme": "bin/bopli-theme.js"
    },
    "main": "dist/cli.js",
    "types": "dist/cli.d.ts",
    "files": [
        "bin",
        "dist",
        "scaffold"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "@bopli/theme-protocol": "0.1.0",
        "@bopli/theme-sdk": "0.5.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/compiler-sfc": "^3.5.13",
        "semver": "^7.7.2",
        "vite": "^8.0.0",
        "vue": "^3.5.13",
        "yazl": "^3.3.1"
    }
}
