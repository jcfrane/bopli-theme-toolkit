{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "rootDir": "src",
        "outDir": "dist",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "references": [{ "path": "../sdk" }]
}
