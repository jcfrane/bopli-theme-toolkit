{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://boply.org/schemas/theme/v1/theme.schema.json",
    "title": "ThemeDescriptor",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "runtimeApiVersion", "handle", "name", "description", "author", "version", "bopli", "preview", "colorModes", "settings", "templates", "runtime", "files"],
    "properties": {
        "schemaVersion": { "$ref": "definitions.schema.json#/$defs/protocolVersion" },
        "runtimeApiVersion": { "$ref": "definitions.schema.json#/$defs/runtimeApiVersion" },
        "handle": { "$ref": "definitions.schema.json#/$defs/handle" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "author": { "type": ["string", "null"], "maxLength": 255 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "bopli": { "type": "string", "minLength": 1, "maxLength": 50 },
        "preview": { "type": ["string", "null"], "maxLength": 500 },
        "colorModes": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
        "settings": { "$ref": "definitions.schema.json#/$defs/themeSettings" },
        "templates": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "definitions.schema.json#/$defs/handle" },
            "additionalProperties": { "$ref": "#/$defs/template" }
        },
        "starter": { "$ref": "starter.schema.json" },
        "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entry", "ssrEntry", "styles"],
            "properties": {
                "entry": { "type": "string", "minLength": 1, "maxLength": 500 },
                "ssrEntry": { "type": "string", "minLength": 1, "maxLength": 500 },
                "styles": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
            }
        },
        "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": { "$ref": "#/$defs/file" }
        }
    },
    "$defs": {
        "template": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "default"],
            "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                "kind": { "$ref": "definitions.schema.json#/$defs/templateKind" },
                "default": { "type": "boolean" },
                "fields": { "$ref": "definitions.schema.json#/$defs/templateFields" }
            }
        },
        "file": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 500 },
                "size": { "type": "integer", "minimum": 1, "maximum": 26214400 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
        }
    }
}
