{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://boply.org/schemas/theme/v1/package-bopli.schema.json",
    "title": "ThemePackageMetadata",
    "type": "object",
    "additionalProperties": false,
    "required": ["handle", "name", "requires"],
    "properties": {
        "handle": { "$ref": "definitions.schema.json#/$defs/handle" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "requires": { "type": "string", "minLength": 1, "maxLength": 50 },
        "preview": { "type": "string", "minLength": 1, "maxLength": 500 },
        "colorModes": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["light", "dark"] }
        },
        "settings": { "$ref": "definitions.schema.json#/$defs/themeSettings" }
    }
}
