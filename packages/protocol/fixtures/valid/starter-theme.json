{
  "schemaVersion": 1,
  "runtimeApiVersion": 1,
  "handle": "starter-theme",
  "name": "Starter Theme",
  "description": "A minimal Bopli theme starter.",
  "author": "Boply",
  "version": "0.1.0",
  "bopli": "^0.1",
  "preview": null,
  "colorModes": [
    "light",
    "dark"
  ],
  "settings": {
    "accent_color": {
      "name": "Accent color",
      "type": "color",
      "default": "#e95420"
    }
  },
  "footer": {
    "settings": {
      "show_social_links": {
        "name": "Show social links",
        "type": "boolean",
        "default": true
      }
    },
    "fields": {
      "message": {
        "name": "Footer message",
        "type": "short_text"
      },
      "links": {
        "name": "Footer links",
        "type": "list",
        "fields": {
          "label": {
            "name": "Label",
            "type": "short_text",
            "required": true
          },
          "url": {
            "name": "Url",
            "type": "url",
            "required": true
          }
        },
        "maxItems": 8,
        "minItems": 0
      }
    },
    "defaults": {
      "message": "Powered by Boply",
      "links": []
    }
  },
  "templates": {
    "home": {
      "name": "Home",
      "kind": "page",
      "default": false,
      "fields": {
        "body": {
          "name": "Body",
          "type": "long_text"
        }
      }
    },
    "page": {
      "name": "Standard page",
      "kind": "page",
      "default": true,
      "fields": {
        "body": {
          "name": "Body",
          "type": "long_text"
        }
      }
    },
    "entry": {
      "name": "Standard entry",
      "kind": "entry",
      "default": true,
      "fields": {
        "body": {
          "name": "Body",
          "type": "long_text",
          "required": true
        }
      }
    }
  },
  "starter": {
    "version": 1,
    "contentModels": [
      {
        "handle": "article",
        "name": "Articles",
        "singularName": "Article",
        "description": "Structured articles published by the starter theme.",
        "fields": [
          {
            "key": "body",
            "label": "Body",
            "type": "long_text",
            "required": true
          }
        ],
        "publicRoute": {
          "template": "entry",
          "path": "/articles/{slug}",
          "fieldMap": {
            "body": "body"
          },
          "seoDescriptionField": "body"
        }
      }
    ],
    "entries": [
      {
        "model": "article",
        "title": "Welcome",
        "slug": "welcome",
        "status": "draft",
        "data": {
          "body": "This entry was created from the theme's starter content."
        }
      }
    ],
    "pages": [
      {
        "title": "Home",
        "path": "/",
        "template": "home",
        "status": "published",
        "data": {
          "body": "Start publishing with Bopli."
        }
      }
    ],
    "blog": {
      "enabled": false
    }
  },
  "runtime": {
    "entry": "./assets/theme-ByF6VLZc.js",
    "ssrEntry": "./assets/theme-ssr-CKOa7ArZ.js",
    "styles": [
      "./assets/style-CHDgKb2I.css"
    ]
  },
  "files": [
    {
      "path": "assets/style-CHDgKb2I.css",
      "size": 420,
      "sha256": "405369b373d2cfc156084aa2c3f02a4197c62b50b9098bb017c91bf864d0e662"
    },
    {
      "path": "assets/theme-ByF6VLZc.js",
      "size": 64410,
      "sha256": "84962e5097b191c5a2e6947f57b60a70a8ec8c47a1df19419a0f1c7fe3b8846d"
    },
    {
      "path": "assets/theme-ssr-CKOa7ArZ.js",
      "size": 77780,
      "sha256": "c9e24046d1b0fedb4581164ff77107409a3270d3fa71817a148f111b74feb84b"
    }
  ]
}
