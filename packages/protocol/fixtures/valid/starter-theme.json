            "key": "body",
            "label": "Body",
            "type": "long_text",
            "required": true
          }
        ],
        "publicRoute": {
          "template": "entry",
          "path": "/articles/{slug}",
          "fieldMap": {
            "body": "body"
          },
          "seoDescriptionField": "body"
        }
      }
    ],
    "entries": [
