{
  "schemaVersion": 1,
  "runtimeApiVersion": 1,
  "handle": "starter-theme",
  "name": "Starter Theme",
  "description": "A minimal Bopli theme starter.",
  "author": "Boply",
  "version": "0.1.0",
  "bopli": "^0.1",
  "preview": null,
  "colorModes": [
    "light",
    "dark"
