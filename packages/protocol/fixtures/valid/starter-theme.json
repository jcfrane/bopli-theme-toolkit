{
  "schemaVersion": 1,
  "runtimeApiVersion": 1,
  "handle": "starter-theme",
  "name": "Starter Theme",
  "description": "A minimal Bopli theme starter.",
  "author": "Boply",
  "version": "0.1.0",
  "bopli": "^0.1",
  "preview": null,
  "colorModes": [
    "light",
    "dark"
  ],
  "settings": {
    "accent_color": {
      "name": "Accent color",
      "type": "color",
      "default": "#e95420"
    }
  },
  "templates": {
    "home": {
      "name": "Home",
      "kind": "page",
      "default": false,
      "fields": {
        "body": {
          "name": "Body",
          "type": "long_text"
        }
      }
    },
    "page": {
      "name": "Standard page",
      "kind": "page",
      "default": true,
      "fields": {
        "body": {
          "name": "Body",
          "type": "long_text"
        }
      }
    },
    "entry": {
      "name": "Standard entry",
      "kind": "entry",
      "default": true,
      "fields": {
        "body": {
          "name": "Body",
          "type": "long_text",
          "required": true
        }
      }
    }
  },
  "starter": {
    "version": 1,
    "contentModels": [
      {
        "handle": "article",
        "name": "Articles",
        "singularName": "Article",
        "description": "Structured articles published by the starter theme.",
        "fields": [
          {
            "key": "body",
            "label": "Body",
            "type": "long_text",
            "required": true
          }
        ],
        "publicRoute": {
          "template": "entry",
          "path": "/articles/{slug}",
          "fieldMap": {
            "body": "body"
          },
          "seoDescriptionField": "body"
        }
      }
    ],
    "entries": [
      {
        "model": "article",
        "title": "Welcome",
        "slug": "welcome",
        "status": "draft",
        "data": {
          "body": "This entry was created from the theme's starter content."
        }
      }
    ],
    "pages": [
      {
        "title": "Home",
        "path": "/",
        "template": "home",
        "status": "published",
        "data": {
          "body": "Start publishing with Bopli."
        }
      }
    ],
    "blog": {
      "enabled": false
    }
  },
  "runtime": {
    "entry": "./assets/theme-DYvWnFsX.js",
    "ssrEntry": "./assets/theme-ssr-DNbbwI3Q.js",
    "styles": [
      "./assets/style-tm4b7Pc-.css"
    ]
  },
  "files": [
    {
