{
    "name": "@bopli/theme-protocol",
    "version": "0.1.0",
    "description": "Machine-readable protocol-v1 schemas and validators for Bopli themes.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jcfrane/bopli-theme-toolkit.git",
        "directory": "packages/protocol"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./schemas/v1/*": "./schemas/v1/*",
        "./fixtures/*": "./fixtures/*"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "schemas",
        "fixtures"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "ajv": "^8.17.1"
    }
}
